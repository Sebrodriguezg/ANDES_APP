# ---------------------------------------------------------------
# Material bibliográfico y bancos de examen: se quedan en local.
# 353 archivos, ~651 MB, con copyright. No van a un repo público.
# ---------------------------------------------------------------
*.pdf
*.djvu
*.epub
*.zip

# Excepción: el cronograma es material propio, generado desde cronograma.tex
!cronograma.pdf
# Los formularios propios sí van al repo: son el entregable de cada semana.
!04_ESTUDIO/formularios/*.pdf

# ---------------------------------------------------------------
# Artefactos de compilación
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# ---------------------------------------------------------------
# Basura del editor y del sistema
# ---------------------------------------------------------------
*.swp
*.swo
.*.swp
*~
.DS_Store

# Los ZIP del paquete de estudio: se regeneran con empaquetar.py y son 1 GB.
_paquete/

# ---------------------------------------------------------------
# App: dependencias y material intermedio de la tubería de contenido
# ---------------------------------------------------------------
node_modules/
07_APP/tuberia/_cache/

# Capturas descargadas de los reportes: se vuelven a bajar cuando hagan falta.
07_APP/tuberia/_cache/capturas/

# La frase de cifrado de las tandas. Nunca sale de este computador.
07_APP/.clave

# Banco de pruebas visual: monta las tarjetas en claro para revisarlas.
docs/_prueba.html
docs/_sim.html
docs/_muestra.json

# Corpus intermedio sin cifrar: es el banco de HRW en texto plano y este repo es
# público. Solo se publican los shards cifrados de docs/contenido/.
07_APP/tuberia/crudo/
